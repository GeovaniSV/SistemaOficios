# Gerado a partir do api/.env local — antes de subir pro servidor,
# CONFIRME/MANTENHA os valores que já são de produção (APP_KEY, APP_URL,
# APP_ENV, DB_*) com o que já está no servidor. Só o bloco RabbitMQ e o
# bloco Cloudflare R2 abaixo foram ajustados pra rodar via docker compose.

APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:KGQ/hkvOpwM4yf6Ni02qp1Ubkoi0+G1jsDjsAtayNrU=
APP_DEBUG=false
APP_URL=https://arcologia.mirtilo.dev.br

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# CONFIRA: copie os valores reais de produção do servidor (estes são os locais)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oficios
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# RabbitMQ — usuário dedicado (não usar "guest": só aceita login via loopback
# real, e a conexão container-a-container pela rede do docker compose não
# conta como loopback, então cairia em ACCESS_REFUSED).
# Se a API NÃO rodar dentro do mesmo docker compose do rabbitmq/workers,
# troque RABBITMQ_HOST para 127.0.0.1 (a porta 5672 é publicada pro host).
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=oficios
RABBITMQ_PASSWORD=776ece14492a4aba2c4b1e084d8e40b9
RABBITMQ_VHOST=/

RABBITMQ_QUEUE=oficios_queue
RABBITMQ_EXCHANGE=
RABBITMQ_ROUTING_KEY=oficios_queue
RABBITMQ_EMAIL_QUEUE=email_queue

# Broker (emailWorker/pdfWorker) auth key for GET /api/broker/smtp-config e POST /api/worker-logs
BROKER_API_KEY=9dJShlQJ9Om4Yo8TIt8h

# Cloudflare R2 (mesmo bucket usado pelo pdfWorker para armazenar os PDFs gerados)
cloudflare_account_id=bc3135393bebd32f546c5bc807fa9405
cloudflare_bucket_name=pdf-worker

cloudflare_access_key_id=fa5a89f81d5b6947b615fe12db0eb0ed
cloudflare_secret_access_key=934899547dc28e5cbd57f45fca5221a5c7f6496dbfc5da76e501407dbec30d13
cloudflare_endpoint=https://bc3135393bebd32f546c5bc807fa9405.r2.cloudflarestorage.com

# Scribe
SCRIBE_AUTH_KEY=5|IyfnMVvZ4SX8Csu8DfR1dF6aAp7dksJ6CYTxLAlw317d1179
